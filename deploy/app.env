# shellcheck shell=bash
# ════════════════════════════════════════════════════════════════════════════
#  app.env — SynaptoMind service configuration
#
#  Vendored from bun-templates/deploy (see lib/common.sh and install.sh).
#  Provenance: https://forgejo.home.lan/authelia/bun-templates commit 89be318daf8adab5ddca957162b3b7df8429e725
# ════════════════════════════════════════════════════════════════════════════

# ── Identity ───────────────────────────────────────────────────────────────
APP_NAME="synaptomind"
APP_DESC="SynaptoMind — thought-graph engine"

# ── Distribution ───────────────────────────────────────────────────────────
DIST="source"

# ── source mode ────────────────────────────────────────────────────────────
REPO_URL="https://github.com/zumik3-del/synaptomind.git"
CHECKOUT_POLICY="stable"

# ── Paths ──────────────────────────────────────────────────────────────────
INSTALL_DIR="/opt/synaptomind"
DATA_DIR="/var/lib/synaptomind"
RUN_DIR=""

# ── First-run seeding ──────────────────────────────────────────────────────
SEED_FILES="config.json.example:config.json .env.example:.env"
GENERATE_SECRET_IN=".env"

# ── Runtime / service ──────────────────────────────────────────────────────
SERVICE_USER=""
EXEC_START=""
PORT="3005"
HEALTH_URL=""
HEALTH_TIMEOUT="60"

# ── source mode extras ─────────────────────────────────────────────────────
REQUIRES_BUN="yes"
SYSTEM_DEP_CMDS="git"
HOOKS_DIR=""
LIB_RAW_URL="https://raw.githubusercontent.com/zumik3-del/synaptomind/main/deploy/lib/common.sh"
