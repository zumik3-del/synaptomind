{
  "contentLanguage": "en",
  "server": {
    "port": 3005,
    "host": "127.0.0.1"
  },
  "mcp": {
    "httpPort": 3006,
    "instructionsFile": "",
    "stdioStandalone": false,
    "corsOrigins": [],
    "maxSessions": 100,
    "sessionTtlMs": 3600000,
    "keepAliveMs": 10000,
    "maxEventsPerSession": 1000
  },
  "db": {
    "path": "./data/synaptomind.db",
    "busyTimeout": 5000
  },

  "embedder": {
    "enabled": true,
    "model": "Xenova/multilingual-e5-small",
    "dtype": "q8",
    "dimensions": 384,
    "pollIntervalMs": 7000,
    "cacheDir": "./data/huggingface",
    "idleTimeoutMs": 600000,
    "precache": false,
    "batchSize": 8,
    "resetDeadLetters": false
  },
  "thoughts": {
    "softLimit": 600,
    "hardLimitBufferPercent": 20
  },
  "decay": {
    "rate": 0.95,
    "intervalMs": 86400000
  },
  "ttl": {
    "archivedTtlDays": -1,
    "cleanupIntervalMs": 86400000
  },
  "primer": {
    "promoteThreshold": 5,
    "topN": 3
  },
  "autoCluster": {
    "minAgeDays": 3,
    "minSimilarity": 0.09,
    "minMembers": 3,
    "dryRun": false
  },
  "edgeDetect": {
    "minSimilarity": 0.75,
    "topK": 10,
    "maxCandidates": 100,
    "maxProposals": 20
  },
  "slots": {
    "defaultMaxChars": 2000,
    "hardLimit": 20000
  },
  "graph": {
    "maxDegree": 50
  },
  "placement": {
    "maxClusterSize": 50,
    "proposalTtlDays": 30,
    "maxPendingProposals": 500
  },
  "search": {
    "confidence": {
      "vectorFloor": 0.9
    }
  },
  "rateLimit": {
    "max": 200,
    "windowMs": 60000,
    "trustProxy": false
  }
}
