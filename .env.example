# SynaptoMind Environment Variables
# Priority: env vars > config.json > hardcoded defaults
#
# This file lists the most common variables only.
# Full list: `ENV_MAPPINGS` in src/config.ts

# Server
# SYNAPTOMIND_PORT=3005
# SYNAPTOMIND_HOST=127.0.0.1

# MCP
# SYNAPTOMIND_MCP_HTTP_PORT=3006

# Content
# Canonical language for stored thought content (ISO code, e.g. "en")
# SYNAPTOMIND_CONTENT_LANGUAGE=en

# Debug logging
# SYNAPTOMIND_DEBUG=false

# Database
# SYNAPTOMIND_DB_PATH=./data/synaptomind.db

# Embedder
# SYNAPTOMIND_EMBEDDER_MODEL=Xenova/multilingual-e5-small
# SYNAPTOMIND_EMBEDDER_DIMENSIONS=384

# Search confidence
# Cosine similarity at or above which a hit counts as a strong match (not
# low_confidence). Default 0.9.
# SYNAPTOMIND_SEARCH_CONFIDENCE_VECTOR_FLOOR=0.9
# Measured cosine similarity of an unrelated query/thought pair — the zero point
# of the calibrated `relevance` scale. Default 0.8 (real e5-small p95 of 4000
# unrelated pairs, task #2178).
# SYNAPTOMIND_SEARCH_CONFIDENCE_UNRELATED_FLOOR=0.8

# Docker bind address (127.0.0.1 for local only, 0.0.0.0 for network access)
# BIND_ADDR=127.0.0.1

# Auth
# Single-user mode (`users: []`, the default) uses SYNAPTOMIND_SECRET. If it is
# unset the server fails closed: authenticated API/MCP requests are rejected
# with 401.
# SYNAPTOMIND_SECRET — bearer token in single-user mode. Deliberately left unset
#   here: a copied placeholder must never become the deployment secret.
#   deploy/install.sh and deploy/update.sh generate a random value when they
#   create .env; set it yourself when provisioning manually.
# Multi-user mode (`config.json` has a `users` list) uses per-user tokens from
#   SYNAPTOMIND_USER_TOKEN_<ID>; SYNAPTOMIND_SECRET and
#   SYNAPTOMIND_ALLOW_INSECURE are ignored. SYNAPTOMIND_SERVICE_TOKEN no longer
#   exists.
# SYNAPTOMIND_ALLOW_INSECURE=true — local-development only, single-user mode
#   only: disables auth entirely and allows anonymous access. Never enable in
#   production.
# SYNAPTOMIND_SECRET=replace-with-a-long-random-token

# Rate limiting
# SYNAPTOMIND_TRUST_PROXY=true — honor X-Forwarded-For / X-Real-IP for the
#   client identity (rightmost X-Forwarded-For hop). Enable only when running
#   behind a trusted reverse proxy; otherwise the socket peer address is used
#   and proxy headers are ignored.
# SYNAPTOMIND_TRUST_PROXY=false
