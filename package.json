{
  "name": "synaptomind",
  "version": "0.7.0-alpha.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "eval": "bun run eval/index.ts",
    "lint": "bunx biome check src/ eval/",
    "smoke": "bash scripts/smoke-test.sh",
    "release": "bash scripts/release.sh",
    "changelog": "bun run scripts/changelog.ts",
    "postinstall": "bash scripts/setup-vec0.sh",
    "prepare": "[ -d .git ] && husky || true"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.5",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
