{
  "name": "synaptomind",
  "version": "0.20.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts --stdio",
    "dev": "bun --watch run src/index.ts",
    "build": "bun run tsc --noEmit",
    "build:binary": "bun run scripts/build-binary.ts",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:all": "bun test",
    "test:deploy": "bun test deploy",
    "test:eval": "bun test eval",
    "test:perf": "SYNAPTOMIND_PERF_SUITE=1 bun test src/services/auto-cluster.perf.test.ts",
    "test:isolated": "bun test src/embedder/client.test.ts src/mcp/http-transport.lifecycle.test.ts",
    "eval": "bun run eval/index.ts",
    "lint": "bunx biome check src/ eval/",
    "lint:docs": "bun run scripts/check-doc-refs.ts",
    "smoke": "bash scripts/smoke-test.sh",
    "release": "bash scripts/release.sh",
    "changelog": "bun run scripts/changelog.ts",
    "postinstall": "bash scripts/setup-vec0.sh",
    "prepare": "[ -d .git ] && husky || true"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.7",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
